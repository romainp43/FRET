[Unit]
Description=FRETRAU - passerelle e-mail (devis automatiques)
After=network-online.target
[Service]
User=fretrau
WorkingDirectory=/opt/fretrau
EnvironmentFile=/etc/fretrau.env
ExecStart=/usr/bin/python3 tools/mail_gateway.py 60
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
