# Copiez en .env (chmod 600). Ne mettez JAMAIS ces valeurs dans le code ni dans le navigateur.
FRETRAU_SECRET=                  # 64 caractères aléatoires : python3 -c "import secrets;print(secrets.token_hex(32))"
FRETRAU_ADMIN_PASSWORD=          # inutile dès que des comptes existent (tools/manage_users.py)
FRETRAU_WEBHOOK_SECRET=          # secret partagé pour signer les e-mails entrants
FRETRAU_PUBLIC_URL=https://fret.example.fr
FRETRAU_ALLOWED_HOSTS=fret.example.fr
FRETRAU_HTTPS=1
FRETRAU_TRUST_PROXY=1
FRETRAU_RETENTION_YEARS=5
# SMTP (e-mails de confirmation)
# FRETRAU_SMTP_HOST=
# FRETRAU_SMTP_PORT=587
# FRETRAU_SMTP_FROM=devis@votre-domaine.fr
# FRETRAU_SMTP_USER=
# FRETRAU_SMTP_PASSWORD=
# Rédaction de messages par IA (optionnel ; ne décide jamais des prix)
# ANTHROPIC_API_KEY=
# Distances routières précises (OSRM auto-hébergé)
# FRETRAU_OSRM_URL=
# Production : désactiver la simulation de suivi (seuls les événements réels du transporteur s'affichent)
FRETRAU_DEMO_TIMELINE=0
# Délai de paiement transporteur après preuve de livraison (0 à 30 jours ; 30 = plafond légal)
FRETRAU_CARRIER_PAY_DAYS=0
# Passerelle e-mail (tools/mail_gateway.py)
# FRETRAU_URL=https://fret.example.fr
# IMAP_HOST=  IMAP_USER=  IMAP_PASSWORD=
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  MAIL_FROM=devis@fret.example.fr

# Itinéraires poids lourd (clé gratuite openrouteservice, 2 000 itinéraires/jour)
# FRETRAU_ORS_KEY=
